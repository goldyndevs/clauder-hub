---
// The one striking visual: the dashboard shows a session stuck on a Bash
// permission, the phone gets it on Telegram, a tap on Allow, and the hub types
// the answer into the terminal. One 10s CSS loop; every element's resting
// style is the resolved end state, which is what reduced motion shows.
import Logo from "./Logo.astro";
---
<div class="demo relative mx-auto w-full max-w-[640px] pb-40 sm:pb-10" aria-label="A session waits on a permission, it is approved from Telegram, and the terminal carries on" role="img">
  <!-- Dashboard window -->
  <div class="card overflow-hidden shadow-xl">
    <div class="flex items-center gap-2 border-b border-border px-3 py-2">
      <Logo size={16} />
      <span class="text-xs font-semibold">Clauder Hub</span>
      <span class="truncate text-[11px] text-muted-foreground">/ api-server</span>
      <span class="ml-auto flex items-center gap-1.5 text-[10px] text-muted-foreground">
        <span class="dot-state h-1.5 w-1.5 rounded-full"></span>
        <span class="grid"><span class="label-wait [grid-area:1/1]">waiting</span><span class="label-run [grid-area:1/1]">working</span></span>
      </span>
    </div>
    <div class="grid grid-cols-[1fr] sm:grid-cols-[150px_1fr]">
      <!-- Sidebar -->
      <div class="hidden border-r border-border p-2 sm:block">
        <p class="px-1.5 pb-1 text-[10px] font-medium uppercase tracking-wide text-muted-foreground">Projects</p>
        <ul class="space-y-0.5 text-xs">
          <li class="flex items-center gap-2 rounded bg-muted px-1.5 py-1 font-medium">
            <span class="dot-state h-1.5 w-1.5 shrink-0 rounded-full"></span>api-server
          </li>
          <li class="flex items-center gap-2 rounded px-1.5 py-1 text-muted-foreground">
            <span class="h-1.5 w-1.5 shrink-0 animate-status-pulse rounded-full bg-success"></span>web-app
          </li>
          <li class="flex items-center gap-2 rounded px-1.5 py-1 text-muted-foreground">
            <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-muted-foreground/40"></span>docs
          </li>
        </ul>
        <p class="mt-3 px-1.5 pb-1 text-[10px] font-medium uppercase tracking-wide text-muted-foreground">Inbox</p>
        <div class="grid">
          <div class="inbox-card mx-0.5 rounded-md border border-border p-1.5 [grid-area:1/1]">
            <span class="badge bg-warning text-background">Permission</span>
            <p class="mt-1 truncate font-mono text-[10px] text-muted-foreground">Bash: npm test</p>
          </div>
          <p class="inbox-empty px-1.5 text-[10px] text-muted-foreground [grid-area:1/1]">Nothing waiting</p>
        </div>
      </div>
      <!-- Terminal -->
      <div class="h-[236px] bg-term p-3 font-mono text-[11px] leading-[1.6] text-term-foreground sm:h-[252px] sm:text-xs">
        <p><span class="text-primary">&gt;</span> refactor the auth module and run the tests</p>
        <p class="mt-1 opacity-70"><span class="text-primary">*</span> Read src/auth/session.ts</p>
        <p class="opacity-70"><span class="text-primary">*</span> Update src/auth/session.ts (+42 -17)</p>
        <div class="mt-2 grid">
          <div class="term-ask [grid-area:1/1] rounded border border-primary/50 px-2 py-1.5">
            <p class="font-semibold">Bash command</p>
            <p class="pl-2 opacity-80">npm test</p>
            <p class="mt-1">Do you want to proceed?</p>
            <p class="text-primary">&gt; 1. Yes</p>
            <p class="pl-3 opacity-70">2. No</p>
          </div>
          <div class="term-after [grid-area:1/1]">
            <p class="text-[#7cc995]">Allowed from Telegram</p>
            <p class="mt-1 opacity-70"><span class="text-primary">*</span> Bash npm test</p>
            <p class="pl-3 opacity-70">48 passed, 0 failed</p>
            <p class="mt-1"><span class="text-primary">*</span> Done. Tests green.<span class="caret ml-0.5 inline-block h-3 w-1.5 translate-y-0.5 bg-primary"></span></p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Phone -->
  <div class="phone absolute bottom-0 right-2 w-[208px] rounded-[26px] border border-border bg-card p-1.5 shadow-2xl sm:-bottom-8 sm:-right-6 sm:w-[224px]">
    <div class="overflow-hidden rounded-[20px] bg-background">
      <div class="flex items-center gap-2 border-b border-border px-3 py-2">
        <span class="grid h-6 w-6 place-items-center rounded-full bg-primary/15"><Logo size={14} /></span>
        <div class="leading-tight">
          <p class="text-[11px] font-semibold">Clauder Hub bot</p>
          <p class="text-[9px] text-muted-foreground">Telegram</p>
        </div>
      </div>
      <div class="space-y-2 p-2.5 text-[11px]">
        <div class="bubble rounded-lg rounded-tl-sm border border-border bg-card p-2">
          <span class="badge bg-warning text-background">Permission</span>
          <p class="mt-1 text-muted-foreground">api-server</p>
          <p class="font-medium">Bash: <span class="font-mono">npm test</span></p>
          <div class="mt-2 grid grid-cols-2 gap-1.5">
            <span class="allow relative rounded py-1 text-center text-[10px] font-medium">
              Allow
              <span class="tap pointer-events-none absolute left-1/2 top-1/2 h-7 w-7 -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary/40"></span>
            </span>
            <span class="rounded bg-muted py-1 text-center text-[10px] font-medium text-muted-foreground">Deny</span>
          </div>
        </div>
        <div class="reply ml-auto w-fit max-w-[85%] rounded-lg rounded-tr-sm bg-primary px-2 py-1.5 text-primary-foreground">
          Allowed. Typed into the terminal.
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Resting state = resolved story (shown as is under reduced motion). */
  .dot-state { background: hsl(var(--success)); animation: dot 10s infinite; }
  .label-wait, .inbox-card { opacity: 0; animation: swap-out 10s infinite; }
  .label-run, .inbox-empty { animation: swap-in 10s infinite; }
  .term-ask { opacity: 0; animation: fade-early 10s infinite; }
  .term-after { opacity: 1; animation: fade-late 10s infinite; }
  .bubble { animation: bubble 10s infinite; }
  .allow { background: hsl(var(--success)); color: hsl(var(--success-foreground)); animation: allow 10s infinite; }
  .tap { opacity: 0; animation: tap 10s infinite; }
  .reply { animation: reply 10s infinite; }
  .caret { animation: blink 1s steps(2) infinite; }
  .phone { animation: float 6s ease-in-out infinite; }

  @keyframes dot {
    0%, 49% { background: hsl(var(--severity-warning)); }
    50%, 100% { background: hsl(var(--success)); }
  }
  @keyframes swap-out { 0%, 49% { opacity: 1; } 51%, 100% { opacity: 0; } }
  @keyframes swap-in { 0%, 49% { opacity: 0; } 51%, 100% { opacity: 1; } }
  @keyframes fade-early { 0%, 48% { opacity: 1; } 52%, 100% { opacity: 0; } }
  @keyframes fade-late { 0%, 50% { opacity: 0; transform: translateY(4px); } 56%, 100% { opacity: 1; transform: none; } }
  @keyframes bubble {
    0%, 12% { opacity: 0; transform: translateY(10px) scale(0.96); }
    18%, 100% { opacity: 1; transform: none; }
  }
  @keyframes allow {
    0%, 41% { background: hsl(var(--foreground)); color: hsl(var(--background)); }
    43%, 100% { background: hsl(var(--success)); color: hsl(var(--success-foreground)); }
  }
  @keyframes tap {
    0%, 36% { opacity: 0; transform: translate(-50%, -50%) scale(0.4); }
    40% { opacity: 1; transform: translate(-50%, -50%) scale(0.9); }
    46%, 100% { opacity: 0; transform: translate(-50%, -50%) scale(1.8); }
  }
  @keyframes reply {
    0%, 52% { opacity: 0; transform: translateY(8px); }
    58%, 100% { opacity: 1; transform: none; }
  }
  @keyframes blink { 0% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes float { 0%, 100% { translate: 0 0; } 50% { translate: 0 -6px; } }
</style>
